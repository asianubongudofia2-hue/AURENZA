ios:
    name: iOS (IPA) 
    environment:
      flutter: stable
      cocoapods: default
    scripts:
      - flutter pub get
      - flutter create .
      - name: Build iOS (no codesign)
        script: |
          # If you want Codemagic to handle signing, remove --no-codesign and configure signing below
          flutter build ios --release --no-codesign
    artifacts:
      - build/ios/ipa/*.ipa
    code_signing:
      # Configure these in Codemagic UI (encrypted environment variables / code signing configuration)
      # distribution_certificate: Encrypted(...)
      # provisioning_profile: Encrypted(...) 